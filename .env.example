NODE_ENV=production
PORT=5000
SESSION_SECRET=replace-with-a-random-secret
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=kurumihost
TELEGRAM_BOT_TOKEN=replace-with-a-new-token-from-BotFather
PASSWORD_RESET_SECRET=replace-with-a-separate-random-secret
DATA_DIR=/var/lib/kurumi-host
ADMIN_USERNAME=NISAN
NAGAD_RECEIVER=01775602198
TERMINAL_BACKEND=docker
DOCKER_TERMINAL_IMAGE=ubuntu:24.04
